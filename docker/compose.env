# Browser-facing (localhost)
WEB_URL=http://localhost:3000
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Internal Docker DNS
DATABASE_URL=postgresql://finance:finance@postgres:5432/finance_app?schema=public
RABBITMQ_URL=amqp://finance:finance@rabbitmq:5672
GRPC_BIND_HOST=0.0.0.0
GRPC_HOST=api-backend:50051
API_INTERNAL_URL=http://api-backend:3001
# python-worker: reach LM Studio on the host via Anthropic-compatible API
ANTHROPIC_API_KEY=lmstudio
ANTHROPIC_BASE_URL=http://host.docker.internal:1234
ANTHROPIC_MODEL=google/gemma-4-e4b
EMAIL_STORAGE_DIR=ingested-emails

# api-backend REST port
PORT=3001
