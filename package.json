{
  "name": "coinmaester",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "precommit": "pnpm lint && pnpm test",
    "docker:dev": "docker compose up -d",
    "docker:down": "docker compose --profile prod down",
    "docker:prod": "bash scripts/docker-prod.sh",
    "worker": "pnpm --filter python-worker dev",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "proto:generate": "pnpm --filter @repo/proto generate",
    "prepare": "sh -c 'if [ \"${HUSKY:-}\" = \"0\" ] || [ ! -d .git ]; then exit 0; fi; exec sh scripts/prepare-husky.sh'"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
