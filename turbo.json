{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "AUTH_SECRET",
    "JWT_EXPIRES_IN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GOOGLE_CALLBACK_URL",
    "WEB_URL",
    "NEXT_PUBLIC_API_URL",
    "API_INTERNAL_URL",
    "TOKEN_ENCRYPTION_KEY",
    "COOKIE_DOMAIN",
    "EMAIL_STORAGE_DIR",
    "RABBITMQ_URL",
    "RABBITMQ_QUEUE",
    "GRPC_PORT",
    "GRPC_HOST",
    "GRPC_BIND_HOST",
    "HF_MODEL_ID",
    "HF_DEVICE",
    "HF_MAX_NEW_TOKENS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "dev": {
      "dependsOn": ["@repo/database#build", "@repo/constant#build"],
      "cache": false,
      "persistent": true
    },
    "python-worker#dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    }
  }
}
