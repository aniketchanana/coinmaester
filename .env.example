# Database
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_app?schema=public"

# Google OAuth (shared by web + api-backend)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
# Docker (pnpm docker:prod) overrides callback to:
#   http://localhost:3000/api/auth/google/callback
# Add that URI in Google Cloud Console → OAuth redirect URIs.

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# 32-byte key for AES-256 refresh token encryption (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
# In production, set to the shared parent domain (e.g. ".example.com") so the
# auth cookie issued by api-backend is visible to the web app. Leave empty in dev.
COOKIE_DOMAIN=""

# Apps
PORT=3001
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Docker sets NEXT_PUBLIC_API_URL=/api (browser uses port 3000 only).
EMAIL_STORAGE_DIR="ingested-emails"

# Messaging
RABBITMQ_URL="amqp://finance:finance@localhost:5672"
RABBITMQ_QUEUE="gmail.messages.process"
GRPC_PORT=50051
GRPC_HOST="localhost:50051"
# Bind address for the unauthenticated internal gRPC server. Keep on loopback;
# only widen (e.g. 0.0.0.0) inside a private container network.
GRPC_BIND_HOST="127.0.0.1"
# The gRPC server starts automatically with the API backend (pnpm --filter api-backend dev)

# LLM (LM Studio + Anthropic SDK)
ANTHROPIC_API_KEY="lmstudio"
ANTHROPIC_BASE_URL="http://localhost:1234"
ANTHROPIC_MODEL="qwen/qwen2.5-coder-14b"

# Docker (pnpm docker:prod)
# docker-compose overrides these for containers — keep browser-facing URLs as localhost above.
#   DATABASE_URL      -> @postgres:5432
#   RABBITMQ_URL      -> @rabbitmq:5672
#   GRPC_HOST         -> api-backend:50051 (python-worker)
#   GRPC_BIND_HOST    -> 0.0.0.0 (api-backend)
#   ANTHROPIC_BASE_URL -> http://host.docker.internal:1234 (python-worker -> LM Studio on host)
