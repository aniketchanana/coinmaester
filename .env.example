# Database
DATABASE_URL="postgresql://finance:finance@localhost:5432/coinmaester?schema=public"

# Google OAuth (shared by web + api-backend)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
# For pnpm docker:prod, container networking overrides live in compose.env.
# The python-worker always runs on the host (pnpm worker), not in Docker.
# Register both OAuth redirect URIs in Google Cloud Console if you use dev and Docker:
#   http://localhost:3001/auth/google/callback
#   http://localhost:3000/api/auth/google/callback

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# 32-byte key for AES-256 refresh token encryption (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
# In production, set to the shared parent domain (e.g. ".example.com") so the
# auth cookie issued by api-backend is visible to the web app. Leave empty in dev.
COOKIE_DOMAIN=""

# Apps
PORT=3001
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
EMAIL_STORAGE_DIR="ingested-emails"

# AI parsing / Gmail sync pipeline (RabbitMQ + python-worker).
# Set to false to disable sync UI and skip RabbitMQ on the API.
# Self-hosted default: true. Hosted/production images typically bake in false.
AI_PARSING_ENABLED=true

# Messaging
RABBITMQ_URL="amqp://finance:finance@localhost:5672"
RABBITMQ_QUEUE="gmail.messages.process"
GRPC_PORT=50051
GRPC_HOST="localhost:50051"
# Bind address for the unauthenticated internal gRPC server. Keep on loopback;
# only widen (e.g. 0.0.0.0) inside a private container network.
GRPC_BIND_HOST="127.0.0.1"
# The gRPC server starts automatically with the API backend (pnpm --filter api-backend dev)

# LLM (in-process Hugging Face model)
HF_MODEL_ID="microsoft/Phi-4-mini-instruct"
HF_DEVICE="auto"
HF_MAX_NEW_TOKENS=1024

AI_PARSING_ENABLED=true

OAUTH_ISSUER_URL="http://localhost:3001"