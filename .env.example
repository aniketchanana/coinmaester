# Database
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance_app?schema=public"

# Google OAuth (shared by web + api-backend)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# 32-byte key for AES-256 refresh token encryption (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# Apps
PORT=3001
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
EMAIL_STORAGE_DIR="ingested-emails"

# Messaging
RABBITMQ_URL="amqp://finance:finance@localhost:5672"
RABBITMQ_QUEUE="gmail.messages.process"
GRPC_PORT=50051
GRPC_HOST="localhost:50051"
# The gRPC server starts automatically with the API backend (pnpm --filter api-backend dev)

# LLM (LM Studio + Anthropic SDK)
ANTHROPIC_API_KEY="lmstudio"
ANTHROPIC_BASE_URL="http://localhost:1234"
ANTHROPIC_MODEL="qwen/qwen2.5-coder-14b"
