generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// App user authenticated via Google OAuth.
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique // Google `sub` / account id
  email     String   @unique
  name      String?

  emailVerified DateTime?

  // OAuth tokens (e.g. for Gmail API later)
  refreshToken       String?   @db.Text
  accessToken        String?   @db.Text
  accessTokenExpires DateTime?
  scope              String? // space-separated granted scopes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailSyncs EmailSync[]

  @@map("users")
}

/// On-demand Gmail sync job queue.
model EmailSync {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  status    SyncStatus @default(PENDING)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("emailSync")
}

/// Ingested Gmail messages.
model GmailMessage {
  id             String   @id @default(cuid())
  conversationId String
  header         String   @db.Text
  messageId      String   @unique
  emailBody      String   @default("") @db.Text
  /// Gmail API `internalDate` (message received time).
  internalDate   DateTime
  status         SyncStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([internalDate(sort: Desc)])
  @@map("gmailMessages")
}
