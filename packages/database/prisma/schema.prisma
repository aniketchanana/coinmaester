generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TransactionType {
  DEBIT
  CREDIT
}

/// App user authenticated via Google OAuth.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?

  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  emailSyncs     EmailSync[]
  gmailMessages  GmailMessage[]
  transactions   Transaction[]
  presetFilters  PresetFilter[]

  @@map("users")
}

/// OAuth provider account linked to a user (e.g. Google).
model Account {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String    @default("google")
  providerAccountId  String
  refreshToken       String?   @db.Text
  accessToken        String?   @db.Text
  accessTokenExpires DateTime?
  scope              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailSyncs EmailSync[]

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// On-demand Gmail sync job queue.
model EmailSync {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status    SyncStatus @default(PENDING)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("emailSync")
}

/// Ingested Gmail messages.
model GmailMessage {
  id             String        @id @default(cuid())
  conversationId String
  header         String        @db.Text
  messageId      String        @unique
  emailBody      String        @default("") @db.Text
  /// Gmail API `internalDate` (message received time).
  internalDate   DateTime
  status         SyncStatus    @default(PENDING)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([internalDate(sort: Desc)])
  @@index([userId])
  @@map("gmailMessages")
}

/// Financial transaction from Gmail extraction or manual entry.
model Transaction {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId   String?         @unique
  gmailMessage     GmailMessage?   @relation(fields: [gmailMessageId], references: [id], onDelete: Cascade)
  bankName         String
  transactionValue Decimal         @db.Decimal(14, 2)
  type             TransactionType
  transactionDate  DateTime
  paymentMadeTo    String
  notes            String?         @db.VarChar(1000)
  isInvestment     Boolean         @default(false)
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, transactionDate(sort: Desc)])
  @@index([userId, isDeleted])
  @@map("transactions")
}

/// Named dashboard filter preset saved by a user.
model PresetFilter {
  id        String   @id @default(cuid())
  name      String
  payee     String?
  /// Strict shape: `{ startDate?: string, endDate?: string }` only.
  dateRange Json?
  /// DEBIT | CREDIT | INVESTMENT (filter facet, not TransactionType alone).
  type      String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@map("presetFilters")
}
