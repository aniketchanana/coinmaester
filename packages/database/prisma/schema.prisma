generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TransactionType {
  DEBIT
  CREDIT
}

/// App user authenticated via Google OAuth.
model User {
  id        String   @id @default(cuid())
  /// Google `sub` of the account used to sign in. Stable login identity — email can be reassigned by a Workspace admin, this cannot.
  googleId  String   @unique
  email     String   @unique
  name      String?

  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gmailAccounts  GmailAccount[]
  emailSyncs     EmailSync[]
  gmailMessages  GmailMessage[]
  transactions   Transaction[]
  presetFilters  PresetFilter[]
  preference     UserPreference?

  mcpApiKeys McpApiKey[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthRefreshTokens      OAuthRefreshToken[]
  @@map("users")
}

/// Gmail OAuth account linked to a user.
model GmailAccount {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String    @default("google")
  providerAccountId  String
  refreshToken       String?   @db.Text
  accessToken        String?   @db.Text
  accessTokenExpires DateTime?
  scope              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emailSyncs EmailSync[]

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("gmailAccounts")
}

/// On-demand Gmail sync job queue.
model EmailSync {
  id              String       @id @default(cuid())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  status          SyncStatus   @default(PENDING)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccountId  String
  gmailAccount    GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([gmailAccountId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("emailSync")
}

/// Ingested Gmail messages.
model GmailMessage {
  id             String        @id @default(cuid())
  conversationId String
  header         String        @db.Text
  messageId      String        @unique
  emailBody      String        @default("") @db.Text
  /// Gmail API `internalDate` (message received time).
  internalDate   DateTime
  status         SyncStatus    @default(PENDING)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([internalDate(sort: Desc)])
  @@index([userId])
  @@map("gmailMessages")
}

/// Financial transaction from Gmail extraction or manual entry.
model Transaction {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId   String?         @unique
  gmailMessage     GmailMessage?   @relation(fields: [gmailMessageId], references: [id], onDelete: Cascade)
  bankName         String
  transactionValue Decimal         @db.Decimal(14, 2)
  type             TransactionType
  transactionDate  DateTime        @db.Date
  paymentMadeTo    String
  notes            String?         @db.VarChar(1000)
  isInvestment     Boolean         @default(false)
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, transactionDate(sort: Desc)])
  @@index([userId, isDeleted])
  @@map("transactions")
}

/// Named dashboard filter preset saved by a user.
model PresetFilter {
  id        String   @id @default(cuid())
  name      String
  payee     String?
  /// Strict shape: `{ startDate?: string, endDate?: string }` only.
  dateRange Json?
  /// DEBIT | CREDIT | INVESTMENT (filter facet, not TransactionType alone).
  type      String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDeleted])
  @@map("presetFilters")
}

model McpApiKey {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Human label the user assigns eg "Gemini"
  name String
  // Non-secret leading chars (e.g. cmk_live_abcd12d) for display in UI
  prefix String
  // HMAC-SHA256 of the full key. the plaintext key is never shared
  keyHash String @unique
  lastUsedAt DateTime?
  // set when revoked null = active (soft delete style)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("mcpApiKeys")
}

/// Per-user app preferences (currency, and future settings).
model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Strict shape: { name: string, symbol: string }
  currencyType Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("userPreferences")
}

model OAuthClient {
  id String @id @default(cuid())
  clientId String @unique

  clientSecretHash String?
  clientName String?

  redirectUris Json
  grantTypes String[]
  scope String?
  tokenEndpointAuthMethod String @default("none")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
  refreshTokens OAuthRefreshToken[]

  @@map("oauthClients")
}

model OAuthAuthorizationCode {
  id String @id @default(cuid())
  code String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  redirectUri String

  codeChallenge String
  codeChallengeMethod String @default("S256")
  scope String?

  resource String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("oauthAuthorizationCodes")
}

model OAuthRefreshToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scope     String?
  resource  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@map("oauthRefreshTokens")
}